# Copy to .env locally; never commit the populated file.
ENVIRONMENT=development
FINANCE_DATABASE_URL=sqlite:///./buy_or_wait_real_world.db
FINANCE_DOCUMENT_ROOT=./var/documents
FINANCE_MAX_UPLOAD_BYTES=10485760

# Plaid Sandbox (owner-provided values; leave blank for CSV-only development)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
FINANCE_TOKEN_ENCRYPTION_KEY=

# Production auth boundary (required when ENVIRONMENT=production)
FINANCE_JWT_PUBLIC_KEY=
FINANCE_JWT_ISSUER=
FINANCE_JWT_AUDIENCE=

# Optional read-only Gmail and FX provider configuration
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
FX_BASE_URL=https://api.frankfurter.app
