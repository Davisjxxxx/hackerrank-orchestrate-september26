{
  "components": {
    "schemas": {
      "Condition": {
        "enum": [
          "unknown",
          "new",
          "refurbished",
          "used",
          "open_box"
        ],
        "title": "Condition",
        "type": "string"
      },
      "EvaluatePayload": {
        "additionalProperties": false,
        "properties": {
          "accepted_conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "title": "Accepted Conditions",
            "type": "array"
          },
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "earliest_safe_full_payment_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Earliest Safe Full Payment Date"
          },
          "financial_coverage_state": {
            "$ref": "#/components/schemas/FinancialCoverageState",
            "default": "unknown"
          },
          "financial_data_as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Financial Data As Of"
          },
          "financial_reason_codes": {
            "items": {
              "type": "string"
            },
            "title": "Financial Reason Codes",
            "type": "array"
          },
          "financial_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FinancialState"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_wait_days": {
            "default": 60,
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Max Wait Days",
            "type": "integer"
          },
          "minimum_balance": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minimum Balance"
          },
          "minimum_savings_dollars": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "default": "25",
            "title": "Minimum Savings Dollars"
          },
          "minimum_savings_fraction": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "default": "0.08",
            "title": "Minimum Savings Fraction"
          },
          "payment_plan": {
            "additionalProperties": true,
            "title": "Payment Plan",
            "type": "object"
          },
          "recommended_payment_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommended Payment Method"
          },
          "safe_amount_today": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safe Amount Today"
          },
          "urgency": {
            "$ref": "#/components/schemas/Urgency",
            "default": "flexible"
          }
        },
        "title": "EvaluatePayload",
        "type": "object"
      },
      "FinancialCoverageState": {
        "enum": [
          "full",
          "partial",
          "stale",
          "unknown"
        ],
        "title": "FinancialCoverageState",
        "type": "string"
      },
      "FinancialState": {
        "enum": [
          "safe_now",
          "safe_with_plan",
          "safe_later",
          "not_affordable"
        ],
