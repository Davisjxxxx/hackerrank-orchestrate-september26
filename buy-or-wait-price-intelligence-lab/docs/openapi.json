        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WatchPayload": {
        "additionalProperties": false,
        "properties": {
          "accepted_conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "title": "Accepted Conditions",
            "type": "array"
          },
          "max_wait_date": {
            "format": "date",
            "title": "Max Wait Date",
            "type": "string"
          },
          "notification_target_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notification Target Ref"
          },
