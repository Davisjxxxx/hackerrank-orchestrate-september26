            "default": false,
            "title": "User Confirmed",
            "type": "boolean"
          }
        },
        "title": "IntakePayload",
        "type": "object"
      },
      "Urgency": {
        "enum": [
          "immediate",
          "needed_soon",
          "flexible",
          "discretionary"
