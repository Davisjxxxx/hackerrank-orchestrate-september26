            "items": {
              "type": "string"
            },
            "title": "Retailer Restrictions",
            "type": "array"
          },
          "source_restrictions": {
            "items": {
              "type": "string"
            },
            "title": "Source Restrictions",
            "type": "array"
          },
          "target_price": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Target Price"
          },
          "urgency": {
            "$ref": "#/components/schemas/Urgency",
            "default": "flexible"
          }
        },
        "required": [
          "target_price",
          "max_wait_date"
        ],
        "title": "WatchPayload",
        "type": "object"
      }
    }
